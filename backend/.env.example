# Export these variables before starting the backend (all optional - defaults work for local development).
ASIET_SECRET_KEY=change-this-secret-before-deploying
ASIET_DEVICE_API_KEY=esp32-dev-key
# 1 = built-in simulator generates SIMULATED readings, 0 = only real ESP32 data
SIMULATOR_ENABLED=1
SIMULATOR_INTERVAL_SECONDS=10
